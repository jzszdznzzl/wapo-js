{
  "name": "wapo-js",
  "version": "0.0.1",
  "description": "Lightweight framework for WhatsApp bots built on top of zapo-js",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "./dist",
    "./package.json",
    "./README"
  ],
  "keywords": [
    "wapo-js",
    "zapo-js",
    "whatsapp",
    "typescript",
    "node",
    "bun"
  ],
  "scripts": {
    "build": "npx tsc",
    "prepare": "npm run build"
  },
  "author": {
    "name": "jzszdznzzl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzszdznzzl/wapo-js.git"
  },
  "bugs": {
    "url": "https://github.com/jzszdznzzl/wapo-js/issues"
  },
  "homepage": "https://github.com/jzszdznzzl/wapo-js#readme",
  "dependencies": {
    "long": "5.3.2",
    "ms": "2.1.3"
  },
  "peerDependencies": {
    "zapo-js": "1.8.0"
  },
  "peerDependenciesMeta": {
    "zapo-js": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/long": "4.0.2",
    "@types/ms": "2.1.0",
    "@types/node": "24",
    "@zapo-js/store-sqlite": "1.1.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
